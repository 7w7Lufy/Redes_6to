
!ROUTER--------------------------------------------------------------------
en 
conf t
hostname Router9
ip domain-name gatito
crypto key generate rsa general-keys modulus 512
line vty 0 5
transport input ssh
login local
exit
username gatito privilege 15 password gatito
enable secret gatito
int Fa0/1
ip add  14.0.0.65 255.255.255.252
no shut
int Fa0/0
ip add 14.0.0.70 255.255.255.252
no shut
int Eth0/0/0
ip add 14.0.0.58 255.255.255.252
no shut
int Eth0/1/0
ip add 14.0.0.81 255.255.255.252
no shut
int Eth0/2/0
ip add 14.0.0.85 255.255.255.252
no shut

router ospf 10
network 14.0.0.68 255.255.255.252 area 0
network 14.0.0.56 255.255.255.252 area 0
network 14.0.0.64 255.255.255.252 area 0
network 14.0.0.84 255.255.255.252 area 0
network 14.0.0.80 255.255.255.252 area 0







!SWITCHCORE----------------------------------
en 
conf t
hostname Switchcapa4
ip domain-name gatito
crypto key generate rsa general-keys modulus 512
line vty 0 5
transport input ssh
login local
exit
username gatito privilege 15 password gatito
enable secret gatito
ip routing
!Se declara la interfaz que conecta al router
int Fa0/1
no switchport
ip add 14.0.0.46 255.255.255.252
no shut
!Interfaces que conecta a los switches
int Fa0/2
switchport trunk encapsulation dot1Q
switchport mode trunk
interface vlan 6
ip add 14.6.175.254 255.255.240.0
!ip  add {penultima ip del combo} [mascara del combo]
no shut
exit

!Pool's para el DHCP
ip dhcp pool vlan6
default-router 14.6.175.254
network 14.6.160.0 255.255.240.0


!Declarar vlan's
vlan 2
name dos
vlan 3
name tres
vlan 4
name cuatro
vlan 5
name cinco
vlan 6
name seis
vlan 7
name siete
vlan 8
name ocho

router ospf 10
network  14.6.160.0 255.255.240.0 area 0
network  14.0.0.44 255.255.255.252 area 0






!SWITCH----------------------------------------------------------------------
en 
conf t
hostname Switch17
ip domain-name gatito
crypto key generate rsa general-keys modulus 512
line vty 0 5
transport input ssh
login local
exit
username gatito privilege 15 password gatito
enable secret gatito
interface vlan 1
ip add 192.168.1.17 255.255.255.0
no shutdown
vlan 2
name dos
vlan 3
name tres
vlan 4
name cuatro
vlan 5
name cinco
vlan 6
name seis
vlan 7
name siete
vlan 8
name ocho
!Conexion a Switchcore
!int Fa0/1
!switchport mode trunk
!Conexion a PC's
int Fa0/2
switchport access vlan 4
int Fa0/3
switchport access vlan 5
int Fa0/3
switchport access vlan 6

int range Fa0/20-22
switchport mode trunk
channel-group 1 mode passive  
exit





!ROUTER--------------------------------------------------------------------
en 
conf t
hostname Router7
ip domain-name gatito
crypto key generate rsa general-keys modulus 512
line vty 0 5
transport input ssh
login local
exit
username gatito privilege 15 password gatito
enable secret gatito
int Fa0/1
ip add 14.0.0.50 255.255.255.252
no shut
int Eth0/0/0
ip add 14.0.0.62 255.255.255.252
no shut
int Fa0/0
ip add 14.0.0.66 255.255.255.252
no shut
int Eth0/1/0
ip add 14.0.0.149 255.255.255.252
no shut

!Por si se ocupan subredes
int Eth0/1/0.2
encapsulation dot1Q 2
!ip add [es la penultima ip del combo] [mascara del combo]
ip add 14.0.15.254 255.255.252.0
no shut
int Eth0/1/0.3
encapsulation dot1Q 3
!ip add [es la penultima ip del combo] [mascara del combo]
ip add 14.1.63.254 255.255.192.0
no shut
exit

!Pool's para el DHCP
ip dhcp pool vlan2
default-router 14.0.15.254
network 14.0.12.0 255.255.252.0
ip dhcp pool vlan3
default-router 14.1.63.254
network 14.1.0.0 255.255.192.0


router ospf 10
network  14.0.12.0 255.255.252.0 area 0
network  14.1.0.0 255.255.192.0 area 0
network 14.0.0.48 255.255.255.252 area 0
network 14.0.0.64 255.255.255.252 area 0
network 14.0.0.60 255.255.255.252 area 0
network 14.0.0.148 255.255.255.252 area 0


