
en 
gatito
reload
no





!ROUTER--------------------------------------------------------------------
en 
conf t
hostname ROUTER1
ip domain-name gatito
crypto key generate rsa general-keys modulus 512
line vty 0 5
transport input ssh
login local
exit
username gatito privilege 15 password gatito
enable secret gatito
int Fa0/0
ip add 17.0.0.9 255.255.255.252
no shut
int Fa0/1
ip add 17.0.0.13 255.255.255.252
no shut
int Eth0/0/0
ip add 17.0.0.6 255.255.255.252
no shut


router ospf 10
network 17.0.0.4 255.255.255.252 area 1
network 17.0.0.8 255.255.255.252 area 1
network 17.0.0.12 255.255.255.252 area 1



!SWITCHCORE----------------------------------
en 
conf t
hostname SWITCHCORE1
ip domain-name gatito
crypto key generate rsa general-keys modulus 512
line vty 0 5
transport input ssh
login local
exit
username gatito privilege 15 password gatito
enable secret gatito
ip routing
!Se declara la interfaz que conecta al router
int Fa0/1
no switchport
ip add 17.0.0.5 255.255.255.252
no shut

!Interfaces que conecta a los switches
int Fa0/2
switchport trunk encapsulation dot1Q
switchport mode trunk
interface vlan 3
ip add 17.0.7.254 255.255.252.0
!ip  add {penultima ip del combo} [mascara del combo]
no shut
interface vlan 4
ip add 17.0.39.254 255.255.248.0
no shut
interface vlan 7
ip add 17.9.255.254 255.254.0.0
no shut
exit

!Pool's para el DHCP
ip dhcp pool vlan3
default-router 17.0.7.254
network 17.0.4.0 255.255.252.0
ip dhcp pool vlan4
default-router 17.0.39.254
network 17.0.32.0 255.255.248.0
ip dhcp pool vlan7
default-router 17.9.255.254
network 17.8.0.0 255.254.0.0

!Declarar vlan's
vlan 3
name tres
vlan 4
name cutro
vlan 5
name cinco
vlan 6
name seis
vlan 7
name siete

router ospf 10
network 17.0.0.4 255.255.255.252 area 1
network 17.0.4.0 255.255.252.0 area 1
network 17.0.32.0 255.255.248.0 area 1
network 17.8.0.0 255.254.0.0 area 1


