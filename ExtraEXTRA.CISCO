ip add 192.168.1.25 255.255.255.0
no shutdown
exit
vlan 3
name tres
vlan 4
name cutro
vlan 5
name cinco
vlan 6
name seis
vlan 7
name siete
!Conexion  Switchcore
int range Fa0/20-22
switchport mode trunk
channel-group 1 mode passive    

!Conexion a PC's
int Fa0/1
switchport access vlan 5
int Fa0/2
switchport access vlan 6
int Fa0/3
switchport access vlan 7
exit