!ROUTER--------------------------------------------------------------------
en 
conf t
hostname Rarea01
ip domain-name gatito
crypto key generate rsa general-keys modulus 512
line vty 0 5
transport input ssh
login local
exit
username gatito privilege 15 password gatito
enable secret gatito
int Fa0/1
ip add 14.0.0.77 255.255.255.252
no shut
int Fa0/0
ip add 14.0.0.74 255.255.255.252
no shut


router ospf 10
network 14.0.0.72 255.255.255.252 area 0
network 14.0.0.76 255.255.255.252 area 0







!SWITCHCORE----------------------------------
en 
conf t
hostname 
ip domain-name gatito
crypto key generate rsa general-keys modulus 512
line vty 0 5
transport input ssh
login local
exit
username gatito privilege 15 password gatito
enable secret gatito
ip routing
!Se declara la interfaz que conecta al router
int Fa0/1
no switchport
ip add 14.0.0.5 255.255.255.252
no shut

!Interfaces que conecta a los switches
int Fa0/2
switchport trunk encapsulation dot1Q
switchport mode trunk
int Fa0/3
switchport trunk encapsulation dot1Q
switchport mode trunk
interface vlan 2
ip add
!ip  add {penultima ip del combo} [mascara del combo]
no shut
interface vlan 3
ip add
no shut
interface vlan 4
ip add  
no shut
interface vlan 5
ip 
no shut
exit

!Pool's para el DHCP
ip dhcp pool vlan2
default-router
network
ip dhcp pool vlan3
default-router 
network 
ip dhcp pool vlan4
default-router 
network 
ip dhcp pool vlan5
default-router 
network 
!Declarar vlan's
vlan 2
name dos
vlan 3
name tres
vlan 4
name cuatro
vlan 5
name cinco

router ospf 10
network  area 0
network  area 0
network  area 0
network  area 0
network area 0



!SWITCH----------------------------------------------------------------------
en 
conf t
hostname SW18
ip domain-name gatito
crypto key generate rsa general-keys modulus 512
line vty 0 5
transport input ssh
login local
exit
username gatito privilege 15 password gatito
enable secret gatito
interface vlan 1
ip add 192.168.1.18 255.255.255.0
no shutdown
exit
vlan 2
name dos
vlan 3
name tres
vlan 4
name cuatro
vlan 5
name cinco
!Conexion a Switchcore
int Fa0/1
switchport mode trunk
!Conexion a PC's
int Fa0/2
switchport access vlan 2
int Fa0/3
switchport access vlan 3
int Fa0/4
switchport access vlan 4
exit


!LACP
int range Fa0/20-22
switchport mode trunk
channel-group 1 mode active

int range Fa0/20-22
switchport mode trunk
channel-group 1 mode passive  


spanning-tree vlan 1 priority 4096




