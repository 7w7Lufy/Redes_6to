!ROUTER--------------------------------------------------------------------
en 
conf t
hostname ROUTER9
ip domain-name gatito
crypto key generate rsa general-keys modulus 512
line vty 0 5
transport input ssh
login local
exit
username gatito privilege 15 password gatito
enable secret gatito
int Fa0/0
ip add 17.0.0. 255.255.255.252
no shut
int Fa0/1
ip add 17.0.0. 255.255.255.252
no shut
int Eth0/0/0
ip add 17.0.0. 255.255.255.252
no shut
int Eth0/1/0 
ip add 17.0.0. 255.255.255.252
no shut
int Eth0/2/0 
ip add 17.0.0. 255.255.255.252
no shut
int Eth0/3/0 
ip add 17.0.0. 255.255.255.252
no shut


