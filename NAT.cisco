!ROUTER--------------------------------------------------------------------
en 
conf t
hostname 
ip domain-name gatito
crypto key generate rsa general-keys modulus 512
line vty 0 5
transport input ssh
login local
exit
username gatito privilege 15 password gatito
enable secret gatito
int Fa0/1
ip add 15.0.0.5 255.255.255.252
no shut
!Por si se ocupan subredes
int Fa0/0.2
encapsulation dot1Q 2
!ip add [es la penultima ip del combo] [mascara del combo]
ip add 15.0.0.30 255.255.255.240
no shut
int Fa0/0.3
encapsulation dot1Q 3
!ip add [es la penultima ip del combo] [mascara del combo]
ip add 15.0.0.14 255.255.255.248
no shut

!Pool's para el DHCP
ip dhcp pool vlan2
default-router 15.0.0.30
network 15.0.0.16 255.255.255.240
ip dhcp pool vlan3
default-router 15.0.0.14
network 15.0.0.8 255.255.255.248

router ospf 1
network 15.0.0.16 0.0.0.15 area 0
network 15.0.0.8 0.0.0.7 area 0
network 15.0.0.4 0.0.0.3 area 0



!ROUTER--------------------------------------------------------------------
en 
conf t
hostname 
ip domain-name gatito
crypto key generate rsa general-keys modulus 512
line vty 0 5
transport input ssh
login local
exit
username gatito privilege 15 password gatito
enable secret gatito
int Fa0/0
ip add 15.0.0.6 255.255.255.252
no shut
!Por si se ocupan subredes
int Fa0/1.2
encapsulation dot1Q 2
!ip add [es la penultima ip del combo] [mascara del combo]
ip add 15.0.0.46 255.255.255.240
no shut
int Fa0/1.3
encapsulation dot1Q 3
!ip add [es la penultima ip del combo] [mascara del combo]
ip add 15.0.0.54 255.255.255.248
no shut

!Pool's para el DHCP
ip dhcp pool vlan2
default-router 15.0.0.46
network 15.0.0.32 255.255.255.240
ip dhcp pool vlan3
default-router 15.0.0.54
network 15.0.0.48 255.255.255.248

router ospf 1
network 15.0.0.4 0.0.0.3 area 0
network 15.0.0.32 0.0.0.15 area 0
network 15.0.0.48 0.0.0.7 area 0


!SWITCH----------------------------------------------------------------------
en 
conf t
hostname
ip domain-name gatito
crypto key generate rsa general-keys modulus 512
line vty 0 5
transport input ssh
login local
exit
username gatito privilege 15 password gatito
enable secret gatito
interface vlan 1
ip add 192.168.1.1 255.255.255.0
no shutdown
exit
vlan 2
name dos
vlan 3
name tres
!Conexion a Switchcore
int Fa0/1
switchport mode trunk
!Conexion a PC's
int Fa0/2
switchport access vlan 2
int Fa0/3
switchport access vlan 3
int Fa0/4
switchport access vlan 2
exit


!SWITCH----------------------------------------------------------------------
en 
conf t
hostname
ip domain-name gatito
crypto key generate rsa general-keys modulus 512
line vty 0 5
transport input ssh
login local
exit
username gatito privilege 15 password gatito
enable secret gatito
interface vlan 1
ip add 192.168.1.2 255.255.255.0
no shutdown
exit
vlan 2
name dos
vlan 3
name tres
!Conexion a Switchcore
int Fa0/1
switchport mode trunk
!Conexion a PC's
int Fa0/2
switchport access vlan 2
int Fa0/3
switchport access vlan 3
int Fa0/4
switchport access vlan 2
exit



